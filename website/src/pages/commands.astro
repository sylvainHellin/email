---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandTable from '../components/CommandTable.astro';
import KeyBindingTable from '../components/KeyBindingTable.astro';
import { Code } from 'astro:components';
// TUI key bindings are GENERATED from the single KEYMAP source of truth in
// src/tui/app/keymap.rs. Do not hand-edit; run scripts/regen-website-keys.sh
// after changing KEYMAP so the site cannot drift from the TUI/help overlay.
import tuiKeys from '../data/tui-keys.json';

const draftCommands = [
  { command: 'mp <selector>', description: 'Preview a draft (dry-run)' },
  { command: 'mp new <name>', description: 'Create a new draft from template and print its selector' },
  { command: 'mp list [--status draft|approved|sent]', description: "List the account's drafts" },
  { command: 'mp validate [<selector>]', description: 'Validate one draft, or every draft of the account' },
  { command: 'mp path <selector>', description: 'Print the filesystem path of a draft' },
  { command: 'mp edit <selector>', description: 'Open a draft in $EDITOR' },
  { command: 'mp mark-approved <selector>', description: 'Mark draft as approved' },
  { command: 'mp mark-draft <selector>', description: 'Demote approved draft back to draft' },
  { command: 'mp delete <drafts-selector> [--force]', description: 'Delete a draft (file + index row); --force is required for an approved draft' },
  { command: 'mp delete --sent', description: "Clear every sent draft of the account" },
  { command: 'mp send <selector> [-y]', description: 'Send a single approved email' },
  { command: 'mp send --invite ...', description: 'Send a calendar invitation (iMIP REQUEST)' },
  { command: 'mp invite accept|tentative|decline <selector>', description: 'RSVP to a received invitation (iMIP REPLY)' },
  { command: 'mp calendar rebuild [--account NAME]', description: 'Report the attendee RSVPs resolved against your sent invites' },
  { command: 'mp send-approved [--all-accounts] [-y]', description: 'Send every approved draft of the account' },
  { command: 'mp outbox list', description: 'Show queued, retrying, failed and partly delivered submissions' },
  { command: 'mp outbox retry <id>', description: 'Send a failed submission again' },
  { command: 'mp outbox discard <id>', description: 'Drop a submission and release its bytes' },
  { command: 'mp reply <selector> [--all]', description: 'Create a reply draft and print its selector' },
  { command: 'mp forward <selector>', description: 'Create a forward draft and print its selector' },
];

const imapCommands = [
  { command: 'mp fetch [filters]', description: 'Fetch emails from server' },
  { command: 'mp sync [options]', description: 'Sync local folders with server' },
  { command: 'mp watch [options]', description: 'Watch mailbox for changes (IMAP IDLE)' },
  { command: 'mp list-mailboxes', description: 'List available server mailboxes' },
  { command: 'mp archive <selector>', description: 'Archive a received email (server + local)' },
  { command: 'mp delete <selector>', description: 'Delete a received email (server + local), or a local draft with a drafts selector' },
  { command: 'mp search <query>', description: 'Search emails on the server with one grammar (fields, has:attachment, dates, OR groups); --local searches the store offline' },
  { command: 'mp open <selector>', description: 'Open attachment in default app' },
  { command: 'mp save <selector> [--output]', description: 'Save attachment(s) to directory' },
];

const storeCommands = [
  { command: 'mp list-messages [--mailbox <name>] [-n N]', description: 'List received messages from the local store (offline)' },
  { command: 'mp show <selector> [--json]', description: 'Print one received message -- headers, attachments and body -- from the local store (offline)' },
  { command: 'mp search --local <query> [--mailbox <name>] [-n N] [--full]', description: 'Ranked full-text search over the local store (offline, every synced mailbox at once)' },
];

const storeOptions = [
  { command: '--mailbox <name>', description: 'Mailbox to list (role, slug or sidebar label). Default: every mailbox of the account, grouped' },
  { command: '-n, --limit <N>', description: 'Max messages per mailbox listed (default: 20)' },
  { command: '-A, --account <name>', description: 'Account to read (default: first in config)' },
  { command: '--json', description: 'mp show only: emit one JSON object instead of the human layout' },
];

const maintenanceCommands = [
  { command: 'mp store gc [--dry-run] [--force] [--all-accounts]', description: 'Run the retention sweep now: evict cached blobs over the disk cap. The first over-cap run only warns and records a marker; run it again to evict. --dry-run prints what would go without touching anything; a plan reclaiming more than half the store is refused without --force. The sweep also runs automatically after every sync.' },
  { command: 'mp cutover [--account NAME] [--dry-run]', description: 'End the pre-1.0 file-era layout: give any draft that has none an id: field, and report the old .md mailbox directories nothing reads any more' },
];

const configCommands = [
  { command: 'mp config init', description: 'Interactive setup wizard' },
  { command: 'mp config show', description: 'Display config (passwords masked)' },
  { command: 'mp config set-password', description: 'Store password in OS keyring' },
  { command: 'mp config oauth2-login', description: 'Run OAuth2 device code flow' },
  { command: 'mp config path', description: 'Print config file path' },
];

const fetchOptions = [
  { command: '--from <addr>', description: 'Filter by sender' },
  { command: '--to <addr>', description: 'Filter by recipient' },
  { command: '--cc <addr>', description: 'Filter by CC' },
  { command: '--subject <text>', description: 'Subject contains' },
  { command: '--body <text>', description: 'Body contains' },
  { command: '--since <YYYY-MM-DD>', description: 'Emails since date' },
  { command: '--before <YYYY-MM-DD>', description: 'Emails before date' },
  { command: '-n, --limit <N>', description: 'Max results (default: 10)' },
  { command: '--full', description: 'Show full body instead of preview' },
  { command: '--mailbox <name>', description: 'Mailbox name (default: INBOX)' },
];

const syncOptions = [
  { command: '-n, --limit <N>', description: 'Max messages per mailbox (default: 50)' },
  { command: '--mailbox <name>...', description: 'Mailboxes to sync (default: all configured)' },
  { command: '--dry-run', description: 'Show what would change without modifying files' },
  { command: '--all-accounts', description: 'Sync every configured account (names the failures, exits 1 if any failed)' },
];

const globalOptions = [
  { command: '-s, --signature <name>', description: 'Use a specific signature' },
  { command: '--no-signature', description: 'Skip signature entirely' },
];

const inviteOptions = [
  { command: '--invite', description: 'Send an iMIP calendar invitation (METHOD:REQUEST)' },
  { command: '--to <addr>', description: 'Attendee(s), comma-separated (also the To header)' },
  { command: '--cc <addr>', description: 'CC attendee(s), comma-separated' },
  { command: '--subject <text>', description: 'Event summary (reused as the email subject)' },
  { command: '--start <when>', description: 'Start: local time or RFC3339 with offset' },
  { command: '--end <when>', description: 'End (same formats as --start); or use --duration' },
  { command: '--duration <dur>', description: 'Duration instead of --end: PT1H30M or 1h30m' },
  { command: '--location <text>', description: 'Optional event location' },
  { command: '--description <text>', description: 'Optional event description / body' },
];

const localSearchSyntax = [
  { command: 'word', description: 'Matches the whole word in subject, sender or body; several words all have to match' },
  { command: '"a phrase"', description: 'Matches the words adjacent, in that order' },
  { command: 'word*', description: 'Prefix match (invoi* finds invoicing)' },
  { command: 'subject:', description: 'Restrict the term to the subject' },
  { command: 'from:', description: 'Restrict the term to the sender' },
  { command: 'body:', description: 'Restrict the term to the body text' },
  { command: '--mailbox <name>', description: 'Restrict the search to one mailbox (default: the whole account)' },
];

const searchSyntax = [
  { command: 'from:', description: 'Filter by sender' },
  { command: 'to:', description: 'Filter by recipient' },
  { command: 'cc:', description: 'Filter by CC' },
  { command: 'subject:', description: 'Filter by subject' },
  { command: 'body:', description: 'Filter by body content' },
  { command: 'filename:', description: 'Match an attachment filename (Gmail/Exchange/--local only)' },
  { command: 'has:attachment', description: 'Only mail carrying an attachment' },
  { command: 'after:', description: 'On or after this date, YYYY-MM-DD (since: is an alias)' },
  { command: 'before:', description: 'Strictly before this date, YYYY-MM-DD' },
  { command: 'message-id:', description: 'Exact RFC 5322 Message-ID lookup; angle brackets optional' },
  { command: 'in:', description: 'Restrict search to a mailbox' },
  { command: '"a phrase"', description: 'A quoted phrase is one term' },
  { command: '(a OR b)', description: 'An OR group; AND-ed with the rest of the query' },
  { command: 'bare text', description: 'Matches any field' },
];

const searchFlags = [
  { command: '--from / --to / --cc / --subject / --body / --filename <s>', description: 'The field prefixes as flags; they build the same query' },
  { command: '--has-attachment', description: 'Only mail carrying an attachment (has:attachment)' },
  { command: '--after / --before <YYYY-MM-DD>', description: 'The date range as flags' },
  { command: '--mailbox <name>', description: 'Scope to one mailbox (per-account only)' },
  { command: '-n, --limit <N>', description: 'Max results (default: 20)' },
  { command: '--full', description: 'Show full body instead of preview' },
  { command: '--local', description: 'Search the local FTS index offline instead of the server' },
];

// Slugify a section title for the heading anchor id.
const slug = (title) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<Layout title="Commands -- mailypoppins" description="Complete reference for mailypoppins CLI commands and TUI key bindings.">
  <Nav />
  <main id="main-content" class="content page">
    <header class="page-header">
      <h1>Commands</h1>
      <p class="subtitle">Complete reference for CLI commands and TUI key bindings.</p>
    </header>

    <section>
      <h2 id="tui">TUI</h2>
      <p>
        Running <code>mp</code> with no arguments launches a full-screen terminal interface
        built on <code>ratatui</code>. The layout has four panes: a sidebar with the mailbox list,
        an email list, a headers pane, and a body preview. Panes adapt to terminal width -- the
        sidebar hides below 40 columns, and the right panes hide below 80 columns.
      </p>
      <p>
        The TUI calls library functions directly (no subprocess spawning). A background IMAP IDLE
        thread watches for new mail and triggers automatic fetches. For Graph API accounts, a
        timer-based poll checks every 60 seconds.
      </p>
    </section>

    <section>
      <h2 id="selectors">Selectors</h2>
      <p>
        Every command that names a message takes a selector, never a file path:
        <code>mp://&lt;account&gt;/&lt;mailbox&gt;/&lt;key&gt;</code>. For received mail the key is the
        Message-ID without its angle brackets; for a draft the mailbox is the reserved name
        <code>drafts</code> and the key is the <code>id:</code> field in the draft's frontmatter,
        so renaming the file does not change its selector.
      </p>
      <p>
        The leading segments can be left off: the account falls back to <code>-A/--account</code>
        or the first account in your config, and the mailbox to <code>--mailbox</code> or the
        command's own scope. <code>mp send 9f2c1ab30d5e4471</code> and
        <code>mp send mp://work/drafts/9f2c1ab30d5e4471</code> are the same command. A key that
        matches messages in two mailboxes is reported with both full selectors rather than
        resolved by guesswork; <code>--mailbox</code> picks one. Every command that creates or
        lists something prints the fully qualified form, which pastes straight into the next
        command, and <code>mp path &lt;selector&gt;</code> is the one way back to a filesystem path.
      </p>
    </section>

    <section>
      <h2 id="draft-commands">Draft Commands</h2>
      <CommandTable commands={draftCommands} />
    </section>

    <section>
      <h2 id="imap-commands">IMAP Commands</h2>
      <CommandTable commands={imapCommands} />
    </section>

    <section>
      <h2 id="store-commands">Local Store Commands</h2>
      <p>
        Two offline reads over what <code>mp sync</code> already brought down. Neither opens a
        connection: they answer from the per-account store, so they work on a plane and cost
        nothing.
      </p>
      <CommandTable commands={storeCommands} />
      <CommandTable commands={storeOptions} />
      <p>
        <code>mp list-messages</code> prints one line per message with its full selector, which
        pastes straight into <code>mp show</code>, <code>mp reply</code> or <code>mp archive</code>.
        With no <code>--mailbox</code> it lists every mailbox of the account, grouped, and the
        limit applies per mailbox so a busy inbox cannot hide the others. The order is the one the
        TUI list shows.
      </p>
      <p>
        <code>mp show</code> takes the same selector grammar as every other message command, so
        the bare Message-ID is enough when it is unambiguous, and an
        <code>mp://&lt;account&gt;/...</code> selector reads that account's store rather than the
        default one. A body the store no longer holds (evicted, or never ingested) prints as a
        note under the headers instead of failing. <code>--json</code> is the parseable form:
        one object with the envelope, the attachment list and the body as a JSON string.
      </p>
      <p>
        <code>mp dump-mailbox --json</code> is a different tool with a similar shape: it is the
        parity oracle, emits newline-delimited envelopes without bodies for every account, and its
        record shape is pinned. Read mail with these two; diff stores with that one.
      </p>
    </section>

    <section>
      <h2 id="maintenance-commands">Maintenance Commands</h2>
      <CommandTable commands={maintenanceCommands} />
      <p>
        Mailypoppins used to keep received mail as one Markdown file per message under
        <code>~/.local/share/mailypoppins/accounts/&lt;account&gt;/</code>. It now keeps it in a
        SQLite store beside a content-addressed blob store, and those old
        <code>inbox/</code>, <code>archive/</code> and <code>sent/</code> directories are dead
        weight. <code>mp cutover</code> is the one-time tidy-up: it lists each dead directory with
        its size and prints the <code>rm</code> line that removes it.
      </p>
      <p>
        It never deletes anything itself, and there is no migration on startup -- it runs only
        when you run it. Its one write is the <code>id:</code> frontmatter field, which is how a
        draft written by the old build becomes addressable by selector; running it again writes
        nothing, and <code>--dry-run</code> writes nothing at all. Drafts are the only local-only
        data in the product, so they are the only thing the old directories hold that the server
        cannot give back -- and they were never in those directories to begin with.
      </p>
    </section>

    <section>
      <h2 id="config-commands">Config Commands</h2>
      <CommandTable commands={configCommands} />
    </section>

    <section>
      <h2 id="fetch-options">Fetch Options</h2>
      <CommandTable commands={fetchOptions} />
    </section>

    <section>
      <h2 id="sync-options">Sync Options</h2>
      <CommandTable commands={syncOptions} />
      <p>
        Sync is additive by default -- it fetches new emails only, deduplicated by Message-ID.
        A two-pass strategy first downloads headers (~50 bytes per message) to identify new emails,
        then fetches full RFC822 bodies only for messages not already stored locally.
      </p>
      <p>
        Deletes are handled by the same pass. The download is capped by <code>--limit</code>,
        the enumeration never is, so a message the server no longer lists is pruned from the
        local store however far it sits below the newest ones, and a mailbox emptied elsewhere
        does not linger.
      </p>
    </section>

    <section>
      <h2 id="invite-options">Invite Options (<code>mp send --invite</code>)</h2>
      <p>
        <code>mp send --invite</code> sends an iMIP calendar invitation
        (<code>METHOD:REQUEST</code>) over SMTP that renders as an actionable
        Accept / Tentative / Decline event in Outlook, Gmail, and Apple Mail.
        Attendees come from <code>--to</code>/<code>--cc</code> and the subject
        is reused as the event summary. Times accept local wall-clock
        (<code>2026-07-20T14:00</code>, <code>"2026-07-20 14:00"</code>) or
        RFC3339 with an offset (<code>2026-07-20T14:00:00+02:00</code>,
        <code>...Z</code>); provide either <code>--end</code> or
        <code>--duration</code>. The <code>ORGANIZER</code> is the sending
        account's primary address (Exchange drops mismatches). Graph accounts
        are not yet supported for invites.
      </p>
      <CommandTable commands={inviteOptions} />
    </section>

    <section>
      <h2 id="rsvp">RSVP to Invitations (<code>mp invite</code>)</h2>
      <p>
        <code>mp invite accept|tentative|decline &lt;selector&gt;</code> replies
        to a received calendar invitation. It reads the invite email's sidecar
        <code>invite.ics</code> (the source of truth for <code>UID</code>/<code>SEQUENCE</code>),
        builds a <code>METHOD:REPLY</code> with your account as the single
        <code>ATTENDEE</code> carrying the chosen <code>PARTSTAT</code>
        (<code>ACCEPTED</code>/<code>TENTATIVE</code>/<code>DECLINED</code>), and
        emails it to the <code>ORGANIZER</code> with an Outlook-convention
        subject (<code>Accepted: &lt;summary&gt;</code>, etc.). On a successful
        send the local <code>event.rsvp</code> is updated. v1 answers the whole
        series only (no per-occurrence responses) and adds no note text.
      </p>
      <p>
        In the TUI, invites show a calendar badge in the list and an event
        summary card at the top of the preview pane; press <code>V</code> to open
        an Accept / Tentative / Decline overlay. <strong>The RSVP is emailed to
        the organizer only — it is not synced to your Exchange server calendar
        (no Graph in v1).</strong> Graph accounts are not yet supported for RSVP.
      </p>
    </section>

    <section>
      <h2 id="calendar-rebuild">Organizer RSVP Tracking (<code>mp calendar rebuild</code>)</h2>
      <p>
        When someone accepts or declines an invitation you sent with
        <code>mp send --invite</code>, their reply arrives as a
        <code>METHOD:REPLY</code> email during normal sync. mailypoppins matches
        it by event <code>UID</code> to your sent invitation and shows that
        attendee's <code>status</code> on the invite, so you can see who
        responded. The statuses are computed from the stored invitation and
        reply messages every time they are shown, so the agenda and the preview
        card are always current with what has arrived.
      </p>
      <p>
        <code>mp calendar rebuild [--account NAME]</code> reports what those
        replies resolve across every stored invitation (defaults to all
        accounts). It writes nothing: there is no cached copy of the statuses to
        rebuild, so it is idempotent by construction, and two machines syncing
        the same account see identical state with no direct machine-to-machine
        sync. Replies for a <code>SEQUENCE</code> older than the invitation's are
        ignored, and the most recent reply per attendee wins.
        <strong>Nothing is written back to the server — without Graph, your
        server-side Exchange calendar is never touched.</strong>
      </p>
    </section>

    <section>
      <h2 id="global-options">Global Options</h2>
      <CommandTable commands={globalOptions} />
    </section>

    <section>
      <h2 id="search-syntax">Search Query Syntax</h2>
      <p>
        The <code>mp search</code> command, its <code>--local</code> mode and the TUI
        server search overlay (<code>f</code>) all speak <strong>one grammar</strong>.
        Fields AND together, <code>(a OR b)</code> groups an alternation, and quoted
        values are supported (e.g., <code>from:"John Doe"</code>). Sylvain's example
        <code>from:boss@corp.com (invoice OR receipt) has:attachment</code> runs on
        every backend. Without an <code>in:</code> prefix or <code>--mailbox</code>, all
        the account's mailboxes are searched. A malformed query is an error with a
        caret pointing at the problem, never a silent search for less.
      </p>
      <CommandTable commands={searchSyntax} />

      <h3 id="search-flags">Flags (same query, for scripting)</h3>
      <p>
        Every field has a matching flag; a flag invocation builds the identical
        query as its positional twin, so
        <code>mp search --from boss@corp.com --has-attachment 'invoice OR receipt'</code>
        equals <code>mp search 'from:boss@corp.com (invoice OR receipt) has:attachment'</code>.
      </p>
      <CommandTable commands={searchFlags} />

      <h3 id="search-attachment-honesty">has:attachment across backends</h3>
      <p>
        On Gmail and Microsoft Exchange <code>has:attachment</code> runs server-side.
        Plain IMAP (RFC 3501) has <em>no</em> attachment search key, so <code>mp</code>
        answers that part from the local store's synced mail and prints a warning that
        un-synced mail is not covered -- run <code>mp sync</code> for full coverage.
      </p>

      <h3 id="local-search-syntax">Local full-text search (<code>--local</code>)</h3>
      <p>
        <code>mp search --local &lt;query&gt;</code> answers from the local store's
        FTS5 index instead of the server: offline, ranked best match first, and
        covering every synced mailbox of the account at once. A subject hit
        outranks the same word buried in a quoted reply. The index is written in
        the same transaction as the message it describes, so it is never stale
        with respect to what <code>mp sync</code> has pulled -- and it holds only
        what has been synced, which is what the server-side search is still for.
        Punctuation is searched as text, not as query syntax.
      </p>
      <CommandTable commands={localSearchSyntax} />
    </section>

    <section>
      <h2 id="tui-keys">TUI Key Bindings</h2>
      <p>
        Generated from the single <code>KEYMAP</code> source of truth
        (<code>src/tui/app/keymap.rs</code>) via <code>mp dump-keys --json</code>;
        see <code>scripts/regen-website-keys.sh</code>. These match the in-TUI
        help overlay (<kbd>?</kbd>) exactly.
      </p>

      {tuiKeys.map((section) => (
        <>
          <h3 id={`${slug(section.title)}-keys`}>{section.title}</h3>
          <KeyBindingTable bindings={section.bindings} />
        </>
      ))}
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-subtext0);
  }

  section {
    margin-bottom: var(--space-4);
  }
</style>
